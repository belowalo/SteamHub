{
  "name": "steamhub",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src \"scripts/*.mjs\" package.json components.json \"tsconfig*.json\" vite.config.ts eslint.config.js .github/workflows/ci.yml",
    "format:check": "prettier --check src \"scripts/*.mjs\" package.json components.json \"tsconfig*.json\" vite.config.ts eslint.config.js .github/workflows/ci.yml",
    "test": "vitest run --maxWorkers=2",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "desktop:package": "tauri build --bundles nsis",
    "desktop:build:debug": "tauri build --debug --no-bundle",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:desktop:ui": "node scripts/desktop-ui-smoke.mjs",
    "test:desktop:library": "node scripts/desktop-library-smoke.mjs",
    "test:desktop:workspace": "node scripts/native-workspace-smoke.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  }
}
